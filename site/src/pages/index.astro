---
import App from '../components/App.jsx';
import heroImg from '../assets/hero.webp';
import '../styles/styles.css';

const title = 'Leandro Teruya — Fullstack Developer';
const description =
  'Leandro Teruya — desenvolvedor fullstack sênior. C#/.NET, Angular, AWS e cloud. ' +
  'Senior fullstack developer building robust backends, Angular frontends and cloud infra.';
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Leandro Teruya de Queiroz" />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={heroImg.src} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&family=Permanent+Marker&display=swap"
      rel="stylesheet"
    />
    <!-- Devicon (tech-stack icons) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
  </head>
  <body>
    <App heroSrc={heroImg.src} client:only="react" />
  </body>
</html>
